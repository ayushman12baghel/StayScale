# Database (PostgreSQL) — mapped to 5433 on host to avoid colliding with local Postgres on 5432
POSTGRES_PORT=5433
POSTGRES_DB=stayscale
POSTGRES_USER=stayscale
POSTGRES_PASSWORD=stayscale_dev

# Cache & Locks (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Event Streaming (Apache Kafka KRaft)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Backend Services
CORE_SERVICE_PORT=8080
WORKER_SERVICE_PORT=8081

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# AI Natural-Language Search (ollama | gemini | deterministic)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
